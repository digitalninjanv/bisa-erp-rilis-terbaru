# A-24 T5 — Production image for Bisa ERP (Jalur 1: Docker Compose).
#
# One build, two outputs from this same Dockerfile:
#   - default target `runner`: slim standalone server (what `app` runs)
#   - target `tools`: full source + dev tooling, used ONLY by the
#     one-shot `migrate` compose service (`pnpm db:migrate`)
#
# Migrations are an explicit, logged step — never a boot side effect:
#   docker compose -f docker-compose.prod.yml --profile tools run --rm migrate
#   docker compose -f docker-compose.prod.yml up -d
# syntax=docker/dockerfile:1

FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.8.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
# Dereferenced copies of the two runtime packages the migration runner
# imports directly (pnpm's node_modules is symlink-based; a plain COPY
# of the link in the runner stage would point into this stage's store).
RUN cp -rL node_modules/drizzle-orm /pkg-drizzle-orm && cp -rL node_modules/postgres /pkg-postgres

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Build-phase placeholders only. The app's env module relaxes exactly the
# BETTER_AUTH_URL production rules during `next build` (nothing is served
# yet); every value is replaced at runtime by the compose env_file
# (.env.prod, generated by deploy/setup-env.sh — secrets are random and
# never committed). The secret below is a throwaway build placeholder,
# deliberately long enough to pass the length rule.
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    DATABASE_URL=postgres://erp:build-placeholder@127.0.0.1:5432/bisa \
    DIRECT_URL=postgres://erp:build-placeholder@127.0.0.1:5432/bisa \
    BETTER_AUTH_SECRET=build-placeholder-secret-not-used-at-runtime-000 \
    BETTER_AUTH_URL=http://bisa-erp.invalid
RUN pnpm build

# One-shot tooling image (migrations). Contains drizzle-kit from the full
# install; run via the compose `tools` profile, then discarded.
FROM builder AS tools
CMD ["pnpm", "db:migrate"]

FROM node:24-alpine AS runner
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1
RUN addgroup -S bisa && adduser -S bisa -G bisa
WORKDIR /app
# Standalone server + the assets server.js serves itself (Next docs:
# copy public/ and .next/static into the standalone tree).
COPY --from=builder --chown=bisa:bisa /app/.next/standalone ./
COPY --from=builder --chown=bisa:bisa /app/.next/static ./.next/static
COPY --from=builder --chown=bisa:bisa /app/public ./public
# Migrations + their runner, so the image can also migrate without the
# tools image: `docker compose exec app node migrate.mjs`.
COPY --from=builder --chown=bisa:bisa /app/src/db/migrations ./migrations
COPY --chown=bisa:bisa deploy/migrate.mjs ./migrate.mjs
# Turbopack bundles the app's own server dependencies; overlay the
# complete runtime packages the migration runner needs (dereferenced
# in the deps stage — see above).
COPY --from=deps --chown=bisa:bisa /pkg-drizzle-orm ./node_modules/drizzle-orm
COPY --from=deps --chown=bisa:bisa /pkg-postgres ./node_modules/postgres
USER bisa
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=4 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
