# A-28 Tahap 6 (H-X-01) — one scheduled restore drill (see
# scripts/restore-drill.sh & docs/RUNBOOK-BACKUP-RESTORE.md).
# Triggered weekly by bisa-erp-restore-drill.timer; may also be
# started by hand:  systemctl start bisa-erp-restore-drill.service
# The drill restores the newest backup into a throwaway database
# named *restore_test*, verifies journal balance and orphan journal lines
# inside that restored snapshot, drops it, and records the outcome in
# restore-drill-manifest.json next to the backups. It does not compare
# with the live source, which may have changed since the backup snapshot.
# The app surfaces the outcome under Pengaturan → Status sistem. A failed
# verification exits non-zero and is visible in `systemctl status` / journal.
[Unit]
Description=Latihan restore database Bisa ERP (drill ke DB sekali pakai)
After=network.target postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/opt/bisa-erp/current
# Read-only secret file scoped to this unit; operational settings are
# sourced by the script without exporting the passphrase.
LoadCredential=backup-passphrase:/etc/credstore/bisa-erp-backup-passphrase
ExecStart=/opt/bisa-erp/current/scripts/restore-drill.sh
