# Contoh env PRODUKSI Bisa ERP — JANGAN diisi manual lalu dipakai.
# Buat berkas aslinya dengan generator (secret selalu acak, tidak pernah
# ditimpa bila sudah ada):
#   Jalur Docker : bash deploy/setup-env.sh --untuk docker   -> .env.prod
#   Jalur systemd: dibuat otomatis oleh deploy/install.sh     -> /etc/bisa-erp/bisa-erp.env
#
# DATABASE_URL memakai peran aplikasi (app_user, kena RLS).
# DIRECT_URL memakai peran pemilik skema (erp) — hanya untuk migrasi,
# backup, dan operasi admin aplikasi. Jaga kerahasiaan keduanya.
DATABASE_URL=postgres://app_user:<sandi-acak>@<host-db>:5432/bisa
DIRECT_URL=postgres://erp:<sandi-acak>@<host-db>:5432/bisa
BETTER_AUTH_SECRET=<minimal-32-karakter-acak>
# Alamat HTTPS yang dipakai browser kasir. Terminasi TLS di reverse
# proxy (nginx/Caddy) yang meneruskan ke aplikasi; jangan pakai http
# di produksi (runtime menolaknya kecuali flag uji lokal).
BETTER_AUTH_URL=https://<alamat-server>
# SEC-012: IP/CIDR reverse proxy tepercaya, mis. 127.0.0.1 atau
# 172.16.0.0/12 untuk jaringan Docker. Kosongkan bila tidak ada proxy.
BISA_TRUSTED_PROXIES=127.0.0.1
NEXT_PUBLIC_APP_NAME=Bisa ERP
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Hanya untuk compose (db): sandi superuser-DB erp & peran app_user.
POSTGRES_PASSWORD=<sandi-acak>
APP_USER_PASSWORD=<sandi-acak>

# A-28 Tahap 6 (H-X-01) — halaman Pengaturan → Status sistem membaca
# manifest backup dari direktori ini (samakan dengan BACKUP_DIR di
# /etc/bisa-erp/backup.conf). Ambang basi: backup > 26 jam atau
# latihan restore > 92 hari memunculkan peringatan di aplikasi.
BISA_BACKUP_DIR=/var/backups/bisa-erp
BISA_BACKUP_MAX_AGE_HOURS=26
BISA_RESTORE_DRILL_MAX_AGE_DAYS=92
