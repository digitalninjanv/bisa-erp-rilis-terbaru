{
  "name": "bisa-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && pnpm typecheck",
    "start": "cp -a public .next/standalone/ && cp -a .next/static .next/standalone/.next/ && node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "db:seed:bulk": "tsx --env-file=.env.local src/db/seed.ts --force --bulk",
    "db:reset": "tsx --env-file=.env.local src/db/seed.ts --force",
    "db:seed:pl": "tsx --env-file=.env.local scripts/seed-demo-pl.ts",
    "bootstrap": "tsx --env-file-if-exists=.env.local scripts/bootstrap.ts",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "prune:idempotency": "tsx --env-file=.env.local scripts/prune-idempotency.ts",
    "prune:pos-outbox": "tsx --env-file=.env.local scripts/prune-pos-outbox.ts",
    "bench:import": "tsx scripts/bench-import.ts",
    "pos:export": "cd pos-desktop && ../node_modules/.bin/next build",
    "dev:webpack": "next dev --webpack",
    "dev:turbopack": "next dev --turbopack",
    "dev:clean": "rm -rf .next/dev && next dev --webpack"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.7.15",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "4.4.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "postgres": "^4.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@tauri-apps/api": "^2.12.4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.5",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.8.0"
}
