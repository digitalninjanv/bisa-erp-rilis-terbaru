# Copy to .env.local and adjust.
DATABASE_URL="postgres://app_user:appdev@localhost:5432/bisa"
DIRECT_URL="postgres://erp:erpdev@localhost:5432/bisa"
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Bisa ERP"

# One-time /setup gate for an empty production database. Generate with
# `openssl rand -hex 24`. Leave empty to disable the web setup (CLI only).
# BISA_SETUP_TOKEN="..."

# Optional: container name used by scripts/backup.sh when pg_dump is not installed locally.
# BISA_PG_CONTAINER="bisa-pg"

# SEC-012: IP/CIDR reverse proxy tepercaya (opsional; mis. 127.0.0.1).
# Tanpa nilai ini, header forwarded multi-hop tidak dipercaya.
# BISA_TRUSTED_PROXIES="127.0.0.1"

# Production demo seed only (explicit opt-in; never use the published demo password):
# BISA_SEED_OWNER_PASSWORD="unique-password-at-least-16-chars"

# Maximum concurrent streamed ledger exports per application process (default 4).
# BISA_LEDGER_EXPORT_LIMIT=4

# Fallback unduhan AppImage bila BISA_POS_RELEASE_DIR belum diisi.
# BISA_POS_DOWNLOAD_FALLBACK_URL="https://github.com/digitalninjanv/bisa-erp-rilis-terbaru/releases/latest/download"
