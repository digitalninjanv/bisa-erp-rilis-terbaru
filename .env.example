# Copy to .env.local and adjust.
DATABASE_URL="postgres://app_user:appdev@localhost:5432/bisa"
DIRECT_URL="postgres://erp:erpdev@localhost:5432/bisa"
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Bisa ERP"

# Optional: container name used by scripts/backup.sh when pg_dump is not installed locally.
# BISA_PG_CONTAINER="bisa-pg"

# SEC-012: IP/CIDR reverse proxy tepercaya (opsional; mis. 127.0.0.1).
# Tanpa nilai ini, header forwarded multi-hop tidak dipercaya.
# BISA_TRUSTED_PROXIES="127.0.0.1"
